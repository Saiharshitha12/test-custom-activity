{
  "workflowApiVersion": "1.1",
  "metaData": {
    "icon": "images/icon.png",
    "category": "message"
  },
  "type": "REST",
  "lang": {
    "en-US": {
      "name": "Test Script Activity",
      "description": "Runs script for every contact"
    }
  },
  "arguments": {
    "execute": {
      "inArguments": [
        { "contactKey":   "{{Contact.Key}}"                    },
        { "mobileNumber": "{{Contact.Attribute.MobileNumber}}" },
        { "firstName":    "{{Contact.Attribute.FirstName}}"    }
      ],
      "outArguments": [],
      "url": "https://test-custom-activity-uv2l.onrender.com/execute",
      "verb": "POST",
      "timeout": 10000,
      "retryCount": 2,
      "retryDelay": 1000
    }
  },
  "configurationArguments": {
    "save":     { "url": "https://test-custom-activity-uv2l.onrender.com/save",     "verb": "POST" },
    "publish":  { "url": "https://test-custom-activity-uv2l.onrender.com/publish",  "verb": "POST" },
    "validate": { "url": "https://test-custom-activity-uv2l.onrender.com/validate", "verb": "POST" }
  },
  "userInterfaces": {
    "configModal": {
      "url": "https://test-custom-activity-uv2l.onrender.com/ui",
      "height": 200,
      "width": 400
    }
  },
  "schema": {
    "arguments": {
      "execute": {
        "inArguments": [
          {
            "contactKey": {
              "dataType": "text",
              "isNullable": false,
              "direction": "in"
            }
          },
          {
            "mobileNumber": {
              "dataType": "text",
              "isNullable": true,
              "direction": "in"
            }
          },
          {
            "firstName": {
              "dataType": "text",
              "isNullable": true,
              "direction": "in"
            }
          }
        ],
        "outArguments": []
      }
    }
  }
}
